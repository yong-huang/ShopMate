# ShopMate environment configuration.
#
# The canonical file is backend/.env.example (System Design section 3.9):
# the backend reads backend/.env from the backend/ working directory, which
# is where `make dev` / `make backend` run it. The variables below mirror
# that file for discoverability.

# --- Model provider ------------------------------------------------------
# LLM_PROVIDER: glm | openai | ollama
LLM_PROVIDER=glm
LLM_MODEL=glm-5.3-flash
LLM_BASE_URL=
LLM_API_KEY=

# --- Ollama (local preset; also used for embeddings) ----------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b

# --- Embeddings -----------------------------------------------------------
# EMBEDDING_PROVIDER: auto | ollama | glm | none
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=bge-m3

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/shopmate.db

# --- Session / profile pipeline ---------------------------------------------
SESSION_IDLE_TTL_MIN=15

# --- Ports (consumed by the root Makefile) -----------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Docker demo (docker compose up / make docker-up) -----------------------
# The same file drives `make dev` and the containerized demo. Inside the
# containers Ollama is reached via http://host.docker.internal:11434
# (docker-compose.yml overrides OLLAMA_BASE_URL), so no value here needs to
# change for either mode. GLM mode: set LLM_API_KEY above — done.
