{
  "id": "checkout-mixed-journey-zh",
  "category": "checkout",
  "lang": "zh",
  "title": "Add then check out inside one conversation",
  "turns": [
    {
      "user": "买一个 HydroPure 加湿器",
      "expect": {
        "expected_tools_subset": [
          "add_to_cart"
        ],
        "cart_expected": {
          "items": [
            {
              "product_id": "HOM-004",
              "quantity": 1
            }
          ],
          "item_count": 1
        }
      }
    },
    {
      "user": "好的，直接下单吧",
      "expect": {
        "expected_tools_subset": [
          "checkout"
        ],
        "cart_expected": {
          "items": [],
          "item_count": 0
        }
      }
    }
  ]
}
