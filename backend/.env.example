# ShopMate backend configuration — System Design section 3.9.
# Copy to backend/.env (the backend loads it from its working directory).

# --- Model provider ----------------------------------------------------
# LLM_PROVIDER: glm | openai | ollama
LLM_PROVIDER=glm
# Any provider model id.
LLM_MODEL=glm-5.3-flash
# Provider OpenAI-compatible endpoint; empty = provider default.
LLM_BASE_URL=
# API key for cloud providers (glm / openai). Leave empty in ollama mode.
LLM_API_KEY=
# Consecutive tool-enabled attempts without a valid tool call before the
# gateway raises ToolCallDegradationError (0 disables the check).
LLM_TOOL_DEGRADATION_ATTEMPTS=3

# --- Ollama (local preset; also used for embeddings) --------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b

# --- Embeddings ---------------------------------------------------------
# EMBEDDING_PROVIDER: auto | ollama | glm | none
EMBEDDING_PROVIDER=auto
# Ollama tag; GLM embedding id when EMBEDDING_PROVIDER=glm.
EMBEDDING_MODEL=bge-m3

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/shopmate.db
# SQLite file for the LangGraph checkpointer (one thread per session;
# conversation state survives backend restarts).
CHECKPOINT_DB_URL=sqlite+aiosqlite:///./data/checkpoints.db

# --- Session / profile pipeline ------------------------------------------
# Idle minutes after which a touched session counts as ended and its profile
# extraction is scheduled (System Design 3.6, ADR-007).
SESSION_IDLE_TTL_MIN=15
# Profile injection cap: the rendered profile block is truncated to this many
# characters (~300 tokens at ~4 chars/token).
PROFILE_INJECTION_MAX_CHARS=1200

# --- Ports (consumed by the root Makefile) -------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Presets:
#   GLM mode (default): set LLM_API_KEY — done.
#   Ollama mode: LLM_PROVIDER=ollama (no key, embeddings included).

# --- Eval harness (T08, docs/eval-plan.md) --------------------------------
# LLM-as-judge provider/model overrides for `make eval` (§3.2). Empty = the
# configured default chat provider/model above.
JUDGE_PROVIDER=
JUDGE_MODEL=
